{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/im-pingo/liveforge/blob/main/docs/config/config.schema.json",
  "title": "LiveForge configuration",
  "description": "Schema for configs/liveforge.yaml. Duration values use Go duration strings such as 30s or 2h.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "server": {"$ref": "#/$defs/server"},
    "tls": {"$ref": "#/$defs/tls"},
    "limits": {"$ref": "#/$defs/limits"},
    "rtmp": {"$ref": "#/$defs/listener"},
    "rtsp": {"$ref": "#/$defs/rtsp"},
    "http_stream": {"$ref": "#/$defs/http_stream"},
    "websocket": {"$ref": "#/$defs/websocket"},
    "webrtc": {"$ref": "#/$defs/webrtc"},
    "srt": {"$ref": "#/$defs/srt"},
    "sip": {"$ref": "#/$defs/sip"},
    "gb28181": {"$ref": "#/$defs/gb28181"},
    "audio_codec": {"$ref": "#/$defs/enabled"},
    "stream": {"$ref": "#/$defs/stream"},
    "auth": {"$ref": "#/$defs/auth"},
    "notify": {"$ref": "#/$defs/notify"},
    "cluster": {"$ref": "#/$defs/cluster"},
    "record": {"$ref": "#/$defs/record"},
    "dvr": {"$ref": "#/$defs/dvr"},
    "metrics": {"$ref": "#/$defs/metrics"},
    "api": {"$ref": "#/$defs/api"},
    "runtime": {"$ref": "#/$defs/runtime"}
  },
  "$defs": {
    "duration": {"type": "string", "pattern": "^[0-9]+(ns|us|ms|s|m|h)$"},
    "enabled": {"type": "object", "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}}},
    "server": {"type": "object", "additionalProperties": false, "properties": {"name": {"type": "string"}, "log_level": {"type": "string", "enum": ["debug", "info", "warn", "error"]}, "drain_timeout": {"$ref": "#/$defs/duration"}}},
    "tls": {"type": "object", "additionalProperties": false, "properties": {"cert_file": {"type": "string"}, "key_file": {"type": "string"}, "auto": {"type": "boolean"}}},
    "limits": {"type": "object", "additionalProperties": false, "properties": {"max_streams": {"type": "integer", "minimum": 0}, "max_subscribers_per_stream": {"type": "integer", "minimum": 0}, "max_connections": {"type": "integer", "minimum": 0}, "max_bitrate_per_stream": {"type": "integer", "minimum": 0}, "rate_limit": {"type": "object", "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}, "rate": {"type": "number", "minimum": 0}, "burst": {"type": "integer", "minimum": 0}}}}},
    "listener": {"type": "object", "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}, "listen": {"type": "string"}, "chunk_size": {"type": "integer", "minimum": 1}, "tls": {"type": ["boolean", "null"]}, "skip_tracker": {"$ref": "#/$defs/skip_tracker"}}},
    "rtsp": {"allOf": [{"$ref": "#/$defs/listener"}, {"type": "object", "properties": {"rtp_port_range": {"$ref": "#/$defs/port_range"}, "multicast": {"$ref": "#/$defs/multicast"}}}]},
    "http_stream": {"type": "object", "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}, "listen": {"type": "string"}, "cors": {"type": "boolean"}, "tls": {"type": ["boolean", "null"]}, "hls": {"$ref": "#/$defs/segmenter"}, "dash": {"$ref": "#/$defs/segmenter"}, "llhls": {"type": "object", "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}, "part_duration": {"type": "number", "exclusiveMinimum": 0}, "segment_count": {"type": "integer", "minimum": 1}, "container": {"type": "string", "enum": ["fmp4", "ts"]}}}}},
    "segmenter": {"type": "object", "additionalProperties": false, "properties": {"segment_duration": {"type": "number", "exclusiveMinimum": 0}, "playlist_size": {"type": "integer", "minimum": 1}}},
    "websocket": {"type": "object", "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}, "listen": {"type": "string"}, "path": {"type": "string"}}},
    "webrtc": {"type": "object", "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}, "listen": {"type": "string"}, "ice_lite": {"type": "boolean"}, "ice_servers": {"type": "array", "items": {"type": "object", "additionalProperties": false, "properties": {"urls": {"type": "array", "items": {"type": "string"}}, "username": {"type": "string"}, "credential": {"type": "string"}}}}, "udp_port_range": {"$ref": "#/$defs/port_range"}, "candidates": {"type": "array", "items": {"type": "string"}}, "tls": {"type": ["boolean", "null"]}, "gcc": {"type": "object", "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}, "initial_bitrate": {"type": "integer", "minimum": 0}, "min_bitrate": {"type": "integer", "minimum": 0}, "max_bitrate": {"type": "integer", "minimum": 0}}}}},
    "srt": {"type": "object", "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}, "listen": {"type": "string"}, "latency": {"type": "integer", "minimum": 0}, "passphrase": {"type": "string"}, "pbkeylen": {"type": "integer", "enum": [0, 16, 24, 32]}, "skip_tracker": {"$ref": "#/$defs/skip_tracker"}}},
    "sip": {"type": "object", "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}, "listen": {"type": "string"}, "transport": {"type": "array", "items": {"type": "string", "enum": ["udp", "tcp"]}}, "server_id": {"type": "string"}, "domain": {"type": "string"}, "auth": {"type": "object", "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}, "password": {"type": "string"}}}, "gateway": {"type": "object", "additionalProperties": true}}},
    "gb28181": {"type": "object", "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}, "stream_prefix": {"type": "string"}, "rtp_port_range": {"$ref": "#/$defs/port_range"}, "ssrc": {"type": "object", "additionalProperties": false, "properties": {"prefix": {"type": "string"}}}, "keepalive": {"type": "object", "additionalProperties": false, "properties": {"interval": {"$ref": "#/$defs/duration"}, "timeout": {"$ref": "#/$defs/duration"}}}, "auto_invite": {"type": "boolean"}, "catalog_interval": {"$ref": "#/$defs/duration"}, "dump_file": {"type": "string"}}},
    "stream": {"type": "object", "additionalProperties": true, "properties": {"gop_cache": {"type": "boolean"}, "gop_cache_num": {"type": "integer", "minimum": 0}, "audio_cache_ms": {"type": "integer", "minimum": 0}, "ring_buffer_size": {"type": "integer", "minimum": 1}, "idle_timeout": {"$ref": "#/$defs/duration"}, "no_publisher_timeout": {"$ref": "#/$defs/duration"}, "slow_consumer": {"type": "object", "additionalProperties": true}, "simulcast": {"type": "object", "additionalProperties": true}, "feedback": {"type": "object", "additionalProperties": true}}},
    "auth": {"type": "object", "additionalProperties": true, "properties": {"enabled": {"type": "boolean"}, "publish": {"type": "object", "additionalProperties": true}, "subscribe": {"type": "object", "additionalProperties": true}, "api": {"type": "object", "additionalProperties": false, "properties": {"bearer_token": {"type": "string"}}}}},
    "notify": {"type": "object", "additionalProperties": true, "properties": {"http": {"type": "object", "additionalProperties": true}, "websocket": {"type": "object", "additionalProperties": true}, "alive_interval": {"$ref": "#/$defs/duration"}}},
    "cluster": {"type": "object", "additionalProperties": true, "properties": {"forward": {"type": "object", "additionalProperties": true}, "origin": {"type": "object", "additionalProperties": true}}},
    "record": {"type": "object", "additionalProperties": true, "properties": {"enabled": {"type": "boolean"}, "stream_pattern": {"type": "string"}, "format": {"type": "string"}, "path": {"type": "string"}}},
    "dvr": {"type": "object", "additionalProperties": true, "properties": {"enabled": {"type": "boolean"}, "listen": {"type": "string"}, "path": {"type": "string"}, "window": {"$ref": "#/$defs/duration"}}},
    "metrics": {"type": "object", "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}, "listen": {"type": "string"}, "path": {"type": "string"}}},
    "api": {"type": "object", "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}, "listen": {"type": "string"}, "tls": {"type": ["boolean", "null"]}, "auth": {"type": "object", "additionalProperties": false, "properties": {"bearer_token": {"type": "string"}, "tokens": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["token", "role"], "properties": {"name": {"type": "string"}, "token": {"type": "string", "minLength": 1}, "role": {"enum": ["viewer", "operator", "admin"]}}}}}}, "console": {"type": "object", "additionalProperties": false, "properties": {"username": {"type": "string"}, "password": {"type": "string"}, "role": {"enum": ["viewer", "operator", "admin"]}}}, "audit": {"type": "object", "additionalProperties": false, "properties": {"max_entries": {"type": "integer", "minimum": 1}}}}},
    "runtime": {"type": "object", "additionalProperties": false, "description": "Background configuration refresh. Source I/O never runs on runtime reads; listener/module changes are restart-required.", "properties": {"source": {"type": "string", "enum": ["file", "http", "consul", "redis"]}, "poll_interval": {"$ref": "#/$defs/duration"}, "load_timeout": {"$ref": "#/$defs/duration"}, "file": {"type": "object", "additionalProperties": false, "properties": {"path": {"type": "string"}}}, "http": {"type": "object", "additionalProperties": false, "properties": {"url": {"type": "string", "format": "uri"}, "token": {"type": "string"}, "max_bytes": {"type": "integer", "minimum": 1}}}, "consul": {"type": "object", "additionalProperties": false, "properties": {"address": {"type": "string", "format": "uri"}, "prefix": {"type": "string", "minLength": 1}, "token": {"type": "string"}, "max_bytes": {"type": "integer", "minimum": 1}}}, "redis": {"type": "object", "additionalProperties": false, "properties": {"addr": {"type": "string"}, "username": {"type": "string"}, "password": {"type": "string"}, "db": {"type": "integer", "minimum": 0}, "prefix": {"type": "string"}, "hash": {"type": "string"}, "version_key": {"type": "string"}, "tls": {"type": "boolean"}}}}},
    "skip_tracker": {"type": "object", "additionalProperties": false, "properties": {"max_count": {"type": "integer"}, "window": {"$ref": "#/$defs/duration"}}},
    "port_range": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1}}
  }
}
